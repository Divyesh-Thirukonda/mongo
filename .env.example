# API and Mac worker: provisioned Atlas sandbox, with cv_ collections.
MONGODB_URI=
MONGODB_DB=aegis

# API only: generate a random secret (at least 32 characters).
# Keep it stable across deploys and outside source control / the app bundle.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000
# Public API deployment: set BOTH origins to the canonical HTTPS origin.
# BETTER_AUTH_URL=https://converge-codex.vercel.app
# CONVERGE_PUBLIC_URL=https://converge-codex.vercel.app

# Mac worker only: do not add the inference key to the public Vercel app.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash
CONVERGE_CODE_MODEL=google/gemini-3.8-flash
# CONVERGE_CODEX_BINARY=/Applications/ChatGPT.app/Contents/Resources/codex

# Native launcher controls are shell variables, not entries loaded from this file:
# CONVERGE_APP_URL=https://converge-codex.vercel.app npm run desktop
# CONVERGE_ENV_FILE=/absolute/path/.env.local
# CONVERGE_DATA_DIR=/absolute/path/converge-data
